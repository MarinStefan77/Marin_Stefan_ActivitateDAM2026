<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

   <Button
       android:id="@+id/btnDeschidereAdaugare"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:text="@string/adauga_articol"
       />

   <Button
       android:id="@+id/btnDeschidereLista"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
      android:text="@string/vezi_lista"
      />

   <TextView
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:text="@string/ultimul_articol_vestimentar_adaugat"
       android:layout_marginTop="24dp"
      />

   <TextView
       android:id="@+id/tvRezultat"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_marginTop="16dp"
      />


</LinearLayout>