<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".ActivitateMasinaAI">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/adaug_o_ma_in_ai_design"
            android:textAlignment="center"
            android:textColor="#3F51B5"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/marca_ma_inii"
            android:textColor="#333333"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etMarca"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_marginBottom="16dp"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="An fabricație"
            android:textColor="#333333"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etAn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_marginBottom="16dp"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preț (EUR)"
            android:textColor="#333333"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etPret"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_marginBottom="16dp"
            android:inputType="numberDecimal" />

        <Switch
            android:id="@+id/swElectrica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Este mașină electrică?"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tip caroserie"
            android:textColor="#333333"
            android:textStyle="bold"/>
        <Spinner
            android:id="@+id/spCaroserie"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="16dp"
            android:entries="@array/tipuri_caroserie"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tracțiune"
            android:textColor="#333333"
            android:textStyle="bold"/>
        <RadioGroup
            android:id="@+id/rgTractiune"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <RadioButton
                android:id="@+id/rbFata"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Față " />
            <RadioButton
                android:id="@+id/rbSpate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spate " />
            <RadioButton
                android:id="@+id/rb4x4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4x4" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rating"
            android:textColor="#333333"
            android:textStyle="bold"/>
        <RatingBar
            android:id="@+id/rbRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5"
            android:layout_marginBottom="16dp"/>

        <CheckBox
            android:id="@+id/cbConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm că datele sunt corecte"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnSalveazaAI"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#3F51B5"
            android:textColor="#FFFFFF"
            android:text="Salvează (AI)"
            android:textSize="18sp" />

    </LinearLayout>
</ScrollView>